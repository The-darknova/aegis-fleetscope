# Aegis FleetScope Server Environment Config

# General
PROJECT_NAME="Aegis FleetScope"
VERSION="1.0.0"

# Database
DATABASE_URL="postgresql://aegis:aegis_password@localhost:5432/aegis_fleetscope"

# Security
# Generate a strong key for production: `openssl rand -hex 32`
SECRET_KEY="super_secret_aegis_key_for_beta"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_DAYS=365

# CORS Origins (JSON list as a string)
CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173"]'

[Unit]
Description=Aegis FleetScope Dashboard
After=network.target aegis-server.service

[Service]
User=aegis
Group=aegis
WorkingDirectory=/opt/aegis-fleetscope/dashboard
# Assuming 'serve' is installed globally or accessible in path to serve the static dist folder
ExecStart=/usr/bin/env serve -s dist -l 8080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

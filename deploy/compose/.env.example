PROJECT_NAME="Aegis FleetScope"
VERSION="1.0.0"

# PostgreSQL Configuration
POSTGRES_USER=aegis
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=aegis_fleetscope

# Backend Configuration
SECRET_KEY=generate_a_secure_random_key_here
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_DAYS=365
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ENROLLMENT_SECRET="default_enrollment_secret"
DATABASE_URL=postgresql://aegis:change_this_password@postgres:5432/aegis_fleetscope
# CORS Origins (JSON list as a string)
CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173"]'
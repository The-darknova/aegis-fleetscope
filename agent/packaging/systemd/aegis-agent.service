[Unit]
Description=Aegis FleetScope Configuration Assessment Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/aegis-agent -config /etc/aegis-fleetscope/agent.yaml
Restart=on-failure
RestartSec=10s

# Security sandboxing
ProtectSystem=full
ProtectHome=read-only
NoNewPrivileges=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
